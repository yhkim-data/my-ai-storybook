{
  "name": "my-ai-storybook",
  "private": true,
  "version": "1.0.0",
  "description": "나만의 AI 동화책 · My AI Storybook — 브라우저만으로 그림책을 만드는 도구",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo-gif": "vite build && node scripts/demo-gif.mjs",
    "social-card": "node scripts/social-card.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "gifenc": "^1.0.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
